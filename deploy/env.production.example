# Copy to /var/www/acciobnb/.env on the droplet
# cp deploy/env.production.example .env

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
PORT=5000

# Generate with: bundle exec rails secret
SECRET_KEY_BASE=replace_me

# MySQL (same server)
DB_USERNAME=acciobnb
DB_PASSWORD=your_strong_password
DB_HOST=127.0.0.1
DB_PORT=3306

# DigitalOcean Spaces (S3-compatible) for Active Storage uploads
DO_SPACES_ACCESS_KEY=your_spaces_access_key
DO_SPACES_SECRET_KEY=your_spaces_secret_key
DO_SPACES_BUCKET=your-existing-space-name
DO_SPACES_REGION=nyc3
DO_SPACES_PREFIX=acciobnb

# Optional: only needed at build time for Google Maps
# REACT_APP_MAPS_API_KEY=your_maps_key

# Set to true for the first deploy if you want demo data
# SEED_DATABASE=true
